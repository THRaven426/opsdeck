# Configuración de opsdeck (/etc/opsdeck/opsdeck.conf)
# Solo se carga si pertenece a root y nadie más puede escribirla.
# Las líneas que empiezan por # son comentarios: quita el # para cambiar un valor.

[general]
# Edición instalada: ligera o completa. La cambia el instalador (sudo ./install.sh --edicion completa).
edicion = ligera
# Grupo del sistema cuyos miembros pueden usar los módulos avanzados de la edición completa.
# grupo_completa = opsdeck-completa
# Módulos que no quieres ver en el menú (ids separados por coma). También desde Catálogo.
# modulos_ocultos =

[auditoria]
# Registro de cambios en /var/log/opsdeck/auditoria.log (una línea por cambio).
# fichero = true
# Copia de cada cambio al registro del sistema (journalctl -t opsdeck).
# syslog = true
# Rotar al superar este tamaño (KB) y cuántos ficheros antiguos (.gz) conservar.
# max_kb = 1024
# conservar = 5

[copias]
# Copia de passwd/shadow/group/sudoers antes de cada cambio en cuentas.
# cuentas = true
# conservar = 10

[resultados]
# Resultados guardados por módulo (escaneos, análisis, informes). Se borran los más antiguos. 0 = sin límite.
# conservar_por_modulo = 50

[red]
# Barandilla de alcance. Los escaneos y pruebas se confinan a las subredes a las que este
# equipo está conectado MÁS las redes que indiques aquí (CIDR, separadas por coma o espacio).
# Un objetivo fuera de ese alcance se bloquea y exige autorización manual, que queda registrada.
# redes_autorizadas = 10.20.0.0/16, 192.168.50.0/24
# true = ignorar las subredes locales y permitir SOLO las de redes_autorizadas (más estricto).
# solo_configuradas = false

[verificacion]
# Verificación de vulnerabilidades. Para saber si un CVE ya está corregido en un paquete de Ubuntu o
# Debian se descarga el aviso de ese CVE desde OSV (solo sale el identificador del CVE, nunca equipos).
# false = no consultar y usar solo los avisos que ya estén en caché.
# consultar_osv = true
# Servidor interactsh PROPIO dentro de la red interna, para las pruebas fuera de banda (Log4Shell,
# SSRF, ejecución ciega). Vacío = esas pruebas no se lanzan. Se rechazan los servidores públicos y
# los que no resuelvan a una dirección interna o autorizada.
# interactsh_servidor = https://oast.interno.empresa.local

[actualizacion]
# Al abrir la interfaz se comprueba si hay una versión nueva (solo consulta el repositorio; no instala
# nada: la actualización se elige en la propia interfaz con la tecla u).
# comprobar_al_abrir = true

[interfaz]
# Tema de colores: opsdeck (oscuro), claro o contraste (alto contraste). También con la tecla t.
# tema = opsdeck

[usuarios]
# shell = /bin/bash
# longitud_password = 16
# minimo_password = 12
# grupos_privilegiados = root sudo wheel admin adm docker lxd libvirt disk shadow kvm kali-trusted

[ldap]
# Conexión por defecto del módulo LDAP (también desde "Guardar conexión"). Nunca se guarda la contraseña.
# servidor = dc01.empresa.local
# usuario = consulta@empresa.local
# base = DC=empresa,DC=local
# cifrado = ldaps
# Verificar el certificado del controlador (yes, recomendado) o aceptar cualquiera (no, solo
# laboratorio: alguien en la red podría suplantar al controlador y quedarse con la contraseña).
# verificar_certificado = yes
# Certificado (PEM) de la CA interna que firma los certificados de los controladores.
# ca = /usr/local/share/ca-certificates/empresa-ca.crt
